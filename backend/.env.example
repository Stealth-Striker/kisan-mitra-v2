# Kisan Mitra Standalone Backend Configuration

# Server Port
PORT=3001

# Allowed CORS Origin (Vite frontend dev server)
CORS_ORIGIN=http://localhost:5173

# SQLite database file path (defaults to backend/kisan.db if not specified)
# DB_PATH=./kisan.db

# JWT Secret for signing session tokens
JWT_SECRET=kisan-mitra-dev-secret-change-in-production

# Front-end App Base URL (used for password reset links)
APP_BASE_URL=http://localhost:5173

# Google Gemini API Key (Required for Crop Doctor & AI Chat)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (gemini-3.5-flash recommended)
GEMINI_MODEL=gemini-3.5-flash

# SMTP Server Configuration for Emails (Verification OTPs, Password Resets)
# If left blank, emails will be printed to the backend console instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Kisan Mitra <noreply@kisanmitra.local>
